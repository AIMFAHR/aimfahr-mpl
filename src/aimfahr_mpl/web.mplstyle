# AIMFAHR · web context: Web pages, notebooks, docs
# Combine with a theme: plt.style.use(["aimfahr_mpl.dark", "aimfahr_mpl.web"])

figure.figsize:   8, 4.5
figure.dpi:       110
savefig.dpi:      200

font.size:        11
axes.titlesize:   13
axes.titlepad:    10
axes.labelsize:   11
axes.labelpad:    6
xtick.labelsize:  10
ytick.labelsize:  10
legend.fontsize:  10
legend.title_fontsize: 10
figure.titlesize: 15
figure.titleweight: 600

lines.linewidth:  2.0
lines.markersize: 6
patch.linewidth:  1.00
axes.linewidth:   0.8
grid.linewidth:   0.8
xtick.major.size: 3.5
ytick.major.size: 3.5
xtick.minor.size: 1.9
ytick.minor.size: 1.9
xtick.major.width: 0.8
ytick.major.width: 0.8
xtick.minor.width: 0.60
ytick.minor.width: 0.60
xtick.major.pad:  3.5
ytick.major.pad:  3.5
boxplot.boxprops.linewidth: 1.20
boxplot.whiskerprops.linewidth: 1.20
boxplot.capprops.linewidth: 1.20
boxplot.medianprops.linewidth: 2.00

# ---- shared layout (applies to every context) ----
font.family:      sans-serif
font.sans-serif:  Montserrat, Inter, Helvetica Neue, Arial, DejaVu Sans
mathtext.fontset: dejavusans
axes.unicode_minus: True
axes.formatter.use_mathtext: True
axes.formatter.limits: -3, 4

axes.spines.top:   False
axes.spines.right: False
axes.axisbelow:    True
axes.grid:         True
axes.grid.which:   major
grid.linestyle:    -
grid.alpha:        1.0
axes.titlelocation: left
axes.titleweight:  600
axes.labelweight:  500
axes.xmargin:      0.02
axes.ymargin:      0.05

xtick.direction:   out
ytick.direction:   out
xtick.minor.visible: False
ytick.minor.visible: False

legend.frameon:    False
legend.handlelength: 1.6
legend.borderaxespad: 0.4
legend.columnspacing: 1.2

lines.solid_capstyle: round
lines.dash_capstyle:  round
scatter.edgecolors:   face
errorbar.capsize:     0
image.interpolation:  nearest
image.aspect:         auto
pcolormesh.snap:      True

figure.constrained_layout.use: True
savefig.bbox:      tight
savefig.pad_inches: 0.15
