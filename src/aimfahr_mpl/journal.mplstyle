# AIMFAHR · journal context: generic one- and two-column journal figures
# Use with the light theme: aimfahr_mpl.use("light", "journal")
# Size figures with aimfahr_mpl.journal_size("single" | "double", aspect)

figure.figsize:   3.5, 2.6
figure.dpi:       150
savefig.dpi:      600
savefig.format:   pdf
pdf.fonttype:     42
ps.fonttype:      42
svg.fonttype:     none

# Neutral sans, as most journals request (Arial or Helvetica)
font.family:      sans-serif
font.sans-serif:  Arial, Helvetica, Liberation Sans, Nimbus Sans, DejaVu Sans
mathtext.fontset: dejavusans
font.size:        8
axes.titlesize:   8
axes.titlepad:    4
axes.labelsize:   8
axes.labelpad:    3
xtick.labelsize:  7
ytick.labelsize:  7
legend.fontsize:  7
legend.title_fontsize: 7
figure.titlesize: 9
figure.titleweight: bold
axes.titleweight: bold
axes.labelweight: normal
axes.titlelocation: left

lines.linewidth:  1.1
lines.markersize: 3.5
patch.linewidth:  0.5
axes.linewidth:   0.6
grid.linewidth:   0.4
xtick.major.size: 3
ytick.major.size: 3
xtick.minor.size: 1.6
ytick.minor.size: 1.6
xtick.major.width: 0.6
ytick.major.width: 0.6
xtick.minor.width: 0.45
ytick.minor.width: 0.45
xtick.major.pad:  2
ytick.major.pad:  2
boxplot.boxprops.linewidth: 0.7
boxplot.whiskerprops.linewidth: 0.7
boxplot.capprops.linewidth: 0.7
boxplot.medianprops.linewidth: 1.1

# Print conventions: full frame off on top/right, no grid, inward ticks
axes.spines.top:   False
axes.spines.right: False
axes.grid:         False
axes.axisbelow:    True
xtick.direction:   in
ytick.direction:   in
xtick.minor.visible: True
ytick.minor.visible: True
axes.unicode_minus: True
axes.formatter.use_mathtext: True
axes.formatter.limits: -3, 4
axes.xmargin:      0.02
axes.ymargin:      0.05

legend.frameon:    False
legend.handlelength: 1.5
legend.borderaxespad: 0.3
legend.columnspacing: 1.0
legend.handletextpad: 0.5

lines.solid_capstyle: round
scatter.edgecolors:   face
errorbar.capsize:     1.5
image.interpolation:  nearest
image.aspect:         auto
pcolormesh.snap:      True

figure.constrained_layout.use: True
figure.constrained_layout.h_pad: 0.02
figure.constrained_layout.w_pad: 0.02
savefig.bbox:      tight
savefig.pad_inches: 0.02

# Darker axes and labels than the screen styles, for print
axes.edgecolor:   4A5A78
xtick.color:      4A5A78
ytick.color:      4A5A78
axes.labelcolor:  0B1F3B
xtick.labelcolor: 0B1F3B
ytick.labelcolor: 0B1F3B
